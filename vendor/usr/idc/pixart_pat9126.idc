device.type = rotaryEncoder

# Ticks per radian
device.res = 57.296

# Chosen so 180-degrees of rotation corresponds
# to scrolling content by the height of one screen
device.scalingFactor = -0.0167

# Transition from Ambient to Interactive on RSB scroll
device.internal = 0
device.wake = 1

rotary_encoder.slop_threshold = 8
rotary_encoder.slop_duration_ms = 500
