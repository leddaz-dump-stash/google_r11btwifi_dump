service vendor.displayoffload-hal-2-1 /vendor/bin/hw/vendor.google_clockwork.displayoffload@2.1-service.pixel
    disabled
    gentle_kill
    class hal
    user system
    group system
    file /dev/kmsg w

on property:vendor.wac.state=booting
    write /sys/devices/platform/panel_0/mux_select/value 1
    stop vendor.displayoffload-hal-2-1

on property:vendor.wac.state=running
    start vendor.displayoffload-hal-2-1

on fs
    chmod 0660 /sys/devices/platform/panel_0/mux_select/value
    chown system system /sys/devices/platform/panel_0/mux_select/value

