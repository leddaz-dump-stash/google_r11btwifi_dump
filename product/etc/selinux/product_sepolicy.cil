(type pdms_app)
(roletype object_r pdms_app)
(type pdms_app_userfaultfd)
(roletype object_r pdms_app_userfaultfd)
(typetransition pdms_app tmpfs file appdomain_tmpfs)
(allow pdms_app pdms_app_userfaultfd (anon_inode (ioctl read create)))
(dontaudit su pdms_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow base_typeattr_1058 pdms_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(allow pdms_app appdomain_tmpfs (file (read write getattr map execute)))
(neverallow base_typeattr_1059 base_typeattr_1058 (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow base_typeattr_1060 pdms_app (file (ioctl read write create setattr lock relabelfrom append unlink link rename open watch watch_mount watch_sb watch_with_perm watch_reads)))
(neverallow base_typeattr_1061 pdms_app (process (ptrace)))
(allow pdms_app app_api_service (service_manager (find)))
(allow pdms_app radio_service (service_manager (find)))
(allow pdms_app privapp_data_file (lnk_file (ioctl read getattr lock map open watch watch_reads)))
(allow pdms_app wear_mode_manager_prop (file (read getattr map open)))
(typetransition pdms_app pdms_app anon_inode "[userfaultfd]" pdms_app_userfaultfd)
(typeattribute base_typeattr_1061)
(typeattributeset base_typeattr_1061 (and (domain ) (not (crash_dump runas_app simpleperf pdms_app ))))
(typeattribute base_typeattr_1060)
(typeattributeset base_typeattr_1060 (and (appdomain ) (not (runas_app shell simpleperf pdms_app ))))
(typeattribute base_typeattr_1059)
(typeattributeset base_typeattr_1059 (and (pdms_app ) (not (runas_app shell simpleperf ))))
(typeattribute base_typeattr_1058)
(typeattributeset base_typeattr_1058 (and (domain ) (not (pdms_app ))))

